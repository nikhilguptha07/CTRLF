# ====================================================================
# CONTROL F — Production Environment Configuration Template (.env.example)
# AI-Powered CCTV Surveillance & Object Recovery System
# ====================================================================

# --------------------------------------------------------------------
# 1. System & Server Configuration
# --------------------------------------------------------------------
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost,https://surveillance.controlf.internal

# --------------------------------------------------------------------
# 2. Oracle Database 21c XE Connection & Pool Configuration
# --------------------------------------------------------------------
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=CTRLF_ADMIN
ORACLE_PASSWORD=ReplaceWithStrongPassword2026!
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=20
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=60

# --------------------------------------------------------------------
# 3. Cryptography & Authentication (HMAC-SHA256 & AES-256-GCM)
# --------------------------------------------------------------------
# Minimum 32 characters for high-entropy JWT signing
JWT_SECRET=ReplaceWithSecureRandomHexSecretMinimum32CharactersLength!
JWT_EXPIRES_IN=24h
# 32-byte hex string (64 characters) for AES-256 camera credential encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --------------------------------------------------------------------
# 4. Python AI Vision Service Integration
# --------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=ReplaceWithSecretInternalApiKeyForVisionService2026
MODEL_NAME=yolov8n
MODEL_VERSION=8.4.136
DETECTION_CONFIDENCE_THRESHOLD=0.35
TRACKING_CONFIRMATION_FRAMES=3

# --------------------------------------------------------------------
# 5. CCTV Camera & RTSP Streaming Configuration
# --------------------------------------------------------------------
RTSP_DEFAULT_TIMEOUT_MS=10000
RTSP_FRAME_SAMPLE_RATE_HZ=1
RTSP_MAX_RETRY_ATTEMPTS=5
RTSP_RECONNECT_BACKOFF_MS=2000

# --------------------------------------------------------------------
# 6. Upload & File Storage Configuration
# --------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=524288000
UPLOAD_DIR=uploads
EVIDENCE_DIR=uploads/evidence
ALLOWED_VIDEO_FORMATS=video/mp4,video/avi,video/quicktime,video/webm

# --------------------------------------------------------------------
# 7. Reverse Proxy & HTTPS Configuration (Optional / Staging)
# --------------------------------------------------------------------
SSL_CERT_PATH=/etc/ssl/certs/controlf.crt
SSL_KEY_PATH=/etc/ssl/private/controlf.key
