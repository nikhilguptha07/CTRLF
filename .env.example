# ====================================================================
# CONTROL F — Production Environment Configuration Template (.env.example)
# AI-Powered CCTV Surveillance & Object Recovery System
# ====================================================================

# --------------------------------------------------------------------
# 1. System & Server Configuration
# --------------------------------------------------------------------
NODE_ENV=production
PORT=5000
API_PREFIX=/api
CLIENT_URL=https://surveillance.internal.controlf.net
CORS_ALLOWED_ORIGINS=https://surveillance.internal.controlf.net,https://controlf.internal

# --------------------------------------------------------------------
# 2. Oracle Database 21c XE Connection & Pool Configuration
# --------------------------------------------------------------------
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
ORACLE_USER=controlf_admin
ORACLE_PASSWORD=ReplaceWithStrongPassword2026!
ORACLE_CONNECTION_STRING=localhost:1521/XEPDB1
ORACLE_POOL_MIN=4
ORACLE_POOL_MAX=20
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=60

# --------------------------------------------------------------------
# 3. Cryptography & Authentication (JWT & AES-256-GCM)
# --------------------------------------------------------------------
# Minimum 32 characters for high-entropy JWT signing
JWT_ACCESS_SECRET=ReplaceWithSecureRandomHexSecretMinimum32CharactersLength!
JWT_REFRESH_SECRET=ReplaceWithSecureRandomRefreshSecretMinimum32Characters!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 32-byte hex string (64 characters) for AES-256 camera credential encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --------------------------------------------------------------------
# 4. Python AI Vision Service Integration
# --------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_KEY=ReplaceWithSecretInternalApiKeyForVisionService2026

# --------------------------------------------------------------------
# 5. File Upload & Storage Architecture
# --------------------------------------------------------------------
# Storage Provider: 'local' | 's3'
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=524288000
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=300
MAX_CONCURRENT_SEARCH_JOBS=4
TARGET_PROCESS_FPS=4.0
EVIDENCE_SELECTION_POLICY=highest_confidence

# --------------------------------------------------------------------
# 6. Rate Limiting & Security Controls
# --------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
DEMO_MODE=false

