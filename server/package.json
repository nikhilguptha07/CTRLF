{
  "name": "control-f-backend",
  "version": "1.0.0",
  "description": "CONTROL F — AI Object Detection & Recovery System Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:clear": "ts-node-dev --transpile-only src/scripts/clearDatabase.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "test:all": "vitest run --fileParallelism=false",
    "test:e2e": "vitest run src/__tests__/phase10JudgeReady.test.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "control-f",
    "surveillance",
    "ai-detection",
    "oracle-database",
    "express",
    "typescript"
  ],
  "author": "CONTROL F Security Architecture",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "oracledb": "^6.7.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
